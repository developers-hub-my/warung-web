---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Halaman Tidak Dijumpai | Warung">
  <div class="min-h-screen flex items-center justify-center bg-amber-50">
    <div class="text-center px-4">
      <h1 class="text-8xl font-extrabold text-amber-500">404</h1>
      <p class="mt-4 text-xl font-semibold text-neutral-900">Halaman Tidak Dijumpai</p>
      <p class="mt-2 text-neutral-600">Maaf, halaman yang anda cari tidak wujud.</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center px-6 py-3 text-sm font-semibold text-neutral-950 bg-amber-500 hover:bg-amber-600 rounded-xl transition-colors"
      >
        Kembali ke Laman Utama
      </a>
    </div>
  </div>
</BaseLayout>

---
import { signupUrl } from '../signup';

const plans = [
  {
    name: 'Percuma',
    price: 'RM 0',
    period: '/bulan',
    description: 'Untuk warung yang baru bermula.',
    features: [
      '1 pengguna',
      'Sehingga 50 produk',
      '1 cawangan',
      'Laporan asas',
      'Berfungsi offline',
      'Pasang di telefon (PWA)',
    ],
    cta: 'Mula Percuma',
    href: signupUrl('free'),
    highlighted: false,
  },
  {
    name: 'Pro',
    price: 'RM 29',
    period: '/bulan',
    description: 'Untuk warung yang sedang berkembang.',
    features: [
      'Sehingga 3 pengguna',
      'Produk tanpa had',
      '1 cawangan',
      'Laporan terperinci',
      'Berfungsi offline',
      'Pelbagai kaedah bayaran',
      'Sokongan keutamaan',
    ],
    cta: 'Pilih Pro',
    href: signupUrl('pro'),
    highlighted: true,
  },
  {
    name: 'Bisnes',
    price: 'RM 79',
    period: '/bulan',
    description: 'Untuk perniagaan pelbagai cawangan.',
    features: [
      'Pengguna tanpa had',
      'Produk tanpa had',
      'Laporan lanjutan & eksport',
      'Berfungsi offline',
      'Pelbagai kaedah bayaran',
      'Sokongan dedikasi',
      'Pengurusan cawangan',
    ],
    cta: 'Pilih Bisnes',
    href: signupUrl('business'),
    highlighted: false,
  },
];
---

<section id="harga" class="scroll-mt-20 bg-cream py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-700">Harga</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
        Harga berpatutan untuk semua
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Mula percuma, naik taraf bila perniagaan anda berkembang.
      </p>
    </div>

    <div class="grid items-stretch gap-6 md:grid-cols-3 lg:gap-8">
      {plans.map((plan) => (
        <div
          class:list={[
            'relative flex flex-col rounded-3xl p-8 lg:p-10',
            plan.highlighted
              ? 'bg-ink text-white shadow-[0_30px_60px_-20px_rgba(9,9,11,0.45)] ring-1 ring-amber-400/40 md:-my-4 md:py-12'
              : 'bg-white text-ink ring-1 ring-ink/5 shadow-[0_1px_2px_rgba(9,9,11,0.04),0_12px_32px_-12px_rgba(9,9,11,0.12)]',
          ]}
        >
          {plan.highlighted && (
            <div aria-hidden="true" class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
          )}
          <h3 class:list={['text-sm font-bold uppercase tracking-[0.14em]', plan.highlighted ? 'text-amber-400' : 'text-amber-700']}>
            {plan.name}
          </h3>
          <div class="mt-5 flex items-baseline gap-1.5">
            <span class="text-5xl font-extrabold tracking-tight">{plan.price}</span>
            <span class:list={['text-sm font-medium', plan.highlighted ? 'text-neutral-400' : 'text-neutral-500']}>{plan.period}</span>
          </div>
          <p class:list={['mt-3 text-sm', plan.highlighted ? 'text-neutral-300' : 'text-neutral-600']}>{plan.description}</p>

          <div class:list={['my-8 h-px', plan.highlighted ? 'bg-white/10' : 'bg-ink/5']}></div>

          <ul class="flex-1 space-y-3.5">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm">
                <span class:list={[
                  'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full',
                  plan.highlighted ? 'bg-amber-400 text-ink' : 'bg-amber-100 text-amber-800',
                ]}>
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span class:list={[plan.highlighted ? 'text-neutral-100' : 'text-neutral-700']}>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={plan.href}
            class:list={[
              'mt-10 block rounded-xl px-6 py-3.5 text-center text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2',
              plan.highlighted
                ? 'bg-amber-500 text-ink hover:bg-amber-400 focus-visible:outline-amber-400'
                : 'bg-ink text-white hover:bg-neutral-800 focus-visible:outline-ink',
            ]}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

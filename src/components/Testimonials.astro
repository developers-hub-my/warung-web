---
const testimonials = [
  {
    quote: 'Warung sangat mudah digunakan. Saya tak perlu latih pekerja lama-lama, terus boleh guna pada hari pertama.',
    name: 'Kak Siti',
    role: 'Pemilik Warung Nasi Lemak Kak Siti, Kajang',
  },
  {
    quote: 'Yang paling best, boleh guna walaupun internet tak stabil. Kedai saya di pasar malam, memang perlukan sistem macam ni.',
    name: 'Abang Rizal',
    role: 'Pemilik Gerai Burger & Roti John, Shah Alam',
  },
  {
    quote: 'Laporan jualan harian bantu saya tahu produk mana yang laris. Sekarang saya boleh plan stok dengan lebih baik.',
    name: 'Puan Aminah',
    role: 'Pemilik Café Kecil, Petaling Jaya',
  },
];

const initials = (name: string) => name.split(' ').map((w) => w[0]).join('');
const [featured, ...rest] = testimonials;
const quoteIcon = 'M3 21c3 0 7-1 7-8V5H3v7h4c0 4-1.5 6-4 6v3Zm11 0c3 0 7-1 7-8V5h-7v7h4c0 4-1.5 6-4 6v3Z';
---

<section class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-amber-700">Kata peniaga</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
        Dipercayai peniaga warung
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Dengar apa kata peniaga yang sudah menggunakan Warung.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-5 lg:gap-8">
      <figure class="relative flex flex-col justify-between overflow-hidden rounded-3xl bg-sand p-8 sm:p-12 lg:col-span-3">
        <svg class="h-10 w-10 text-amber-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={quoteIcon} /></svg>
        <blockquote class="mt-8 text-2xl font-semibold leading-snug tracking-tight text-ink sm:text-3xl">
          {featured.quote}
        </blockquote>
        <figcaption class="mt-10 flex items-center gap-4">
          <span aria-hidden="true" class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-500 text-sm font-extrabold text-ink">{initials(featured.name)}</span>
          <span>
            <span class="block font-bold text-ink">{featured.name}</span>
            <span class="block text-sm text-neutral-600">{featured.role}</span>
          </span>
        </figcaption>
      </figure>

      <div class="grid gap-6 lg:col-span-2 lg:gap-8">
        {rest.map((t) => (
          <figure class="flex flex-col justify-between rounded-3xl bg-white p-8 ring-1 ring-ink/5 shadow-[0_1px_2px_rgba(9,9,11,0.04),0_12px_32px_-12px_rgba(9,9,11,0.12)]">
            <svg class="h-6 w-6 text-amber-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={quoteIcon} /></svg>
            <blockquote class="mt-4 leading-relaxed text-neutral-700">{t.quote}</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-500 text-xs font-extrabold text-ink">{initials(t.name)}</span>
              <span>
                <span class="block text-sm font-bold text-ink">{t.name}</span>
                <span class="block text-xs text-neutral-500">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

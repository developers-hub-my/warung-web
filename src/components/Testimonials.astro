---
const testimonials = [
  {
    quote: 'Warung sangat mudah digunakan. Saya tak perlu latih pekerja lama-lama, terus boleh guna pada hari pertama.',
    name: 'Kak Siti',
    role: 'Pemilik Warung Nasi Lemak Kak Siti, Kajang',
  },
  {
    quote: 'Yang paling best, boleh guna walaupun internet tak stabil. Kedai saya di pasar malam, memang perlukan sistem macam ni.',
    name: 'Abang Rizal',
    role: 'Pemilik Gerai Burger & Roti John, Shah Alam',
  },
  {
    quote: 'Laporan jualan harian bantu saya tahu produk mana yang laris. Sekarang saya boleh plan stok dengan lebih baik.',
    name: 'Puan Aminah',
    role: 'Pemilik Café Kecil, Petaling Jaya',
  },
];
---

<section class="py-16 sm:py-24 bg-neutral-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900">
        Dipercayai peniaga warung
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Dengar apa kata peniaga yang sudah menggunakan Warung.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((t) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-neutral-100">
          <div class="flex gap-1 mb-4">
            {[...Array(5)].map(() => (
              <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-neutral-700 text-sm leading-relaxed mb-4">"{t.quote}"</p>
          <div>
            <p class="font-semibold text-neutral-900 text-sm">{t.name}</p>
            <p class="text-xs text-neutral-500">{t.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

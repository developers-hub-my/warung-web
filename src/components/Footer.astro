---
import { signupUrl, loginUrl } from '../signup';
const currentYear = new Date().getFullYear();
---

<footer id="hubungi" class="bg-neutral-900 text-neutral-400 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <img src="/logo.svg" alt="Warung" class="h-8 w-8 rounded-lg" />
          <span class="text-lg font-bold text-white">Warung</span>
        </div>
        <p class="text-sm leading-relaxed">
          Juruwang digital untuk warung anda. Sistem POS moden untuk peniaga kecil di Malaysia.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Pautan</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#ciri-ciri" class="hover:text-amber-400 transition-colors">Ciri-ciri</a></li>
          <li><a href="#harga" class="hover:text-amber-400 transition-colors">Harga</a></li>
          <li><a href={signupUrl()} class="hover:text-amber-400 transition-colors">Daftar</a></li>
          <li><a href={loginUrl} class="hover:text-amber-400 transition-colors">Log Masuk</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold text-white mb-4">Hubungi Kami</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:hello@warung.my" class="hover:text-amber-400 transition-colors">
              hello@warung.my
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-neutral-800 text-center text-sm">
      <p>&copy; {currentYear} Warung. Hak cipta terpelihara.</p>
    </div>
  </div>
</footer>

---
import { photos } from '../data/photos';

// Lucide-style inline icons, 1.75 stroke.
const icon = (paths: string) =>
  `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

const icons = {
  wifiOff: icon('<path d="M12 20h.01"/><path d="M8.5 16.43a5 5 0 0 1 7 0"/><path d="M5 12.86a10 10 0 0 1 5.17-2.69"/><path d="M19 12.86a10 10 0 0 0-2-1.52"/><path d="M2 8.82a15 15 0 0 1 4.18-2.64"/><path d="M22 8.82a15 15 0 0 0-11.29-3.76"/><path d="m2 2 20 20"/>'),
  receipt: icon('<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>'),
  chart: icon('<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>'),
  phone: icon('<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>'),
};

const imgClass = 'absolute inset-0 h-full w-full object-cover text-transparent transition-transform duration-700 ease-out group-hover:scale-105';
const tile = 'group relative overflow-hidden rounded-3xl shadow-[0_1px_2px_rgb(9_9_11/0.05),0_12px_32px_-14px_rgb(9_9_11/0.22)]';
const eyebrow = 'text-xs font-bold uppercase tracking-[0.14em]';
---

<section id="ciri" class="py-20 sm:py-28 bg-cream scroll-mt-20" aria-labelledby="ciri-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-amber-700">Ciri-ciri</p>
      <h2 id="ciri-heading" class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-ink leading-[1.05]">
        Semua yang anda perlukan untuk urus kedai
      </h2>
      <p class="mt-5 text-lg text-neutral-600 leading-relaxed">
        Warung direka khas untuk peniaga kecil di Malaysia — ringkas, pantas dan berkuasa.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3 lg:auto-rows-[minmax(16rem,auto)]">
      <!-- Offline: dark tile with the real offline till screenshot -->
      <article class={`${tile} bg-ink text-white lg:col-span-2 flex flex-col sm:flex-row`}>
        <div class="p-7 sm:p-9 sm:w-1/2 flex flex-col justify-between gap-6">
          <div>
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-400 text-ink" set:html={icons.wifiOff} />
            <h3 class="mt-6 text-2xl font-extrabold tracking-tight">Berfungsi Tanpa Internet</h3>
            <p class="mt-3 text-white/75 leading-relaxed">
              Kedai anda tidak akan terganggu walaupun tiada internet. Warung berfungsi secara offline dan sync semula apabila online.
            </p>
          </div>
          <p class={`${eyebrow} text-amber-300`}>Skrin sebenar · mod luar talian</p>
        </div>
        <div class="relative sm:w-1/2 min-h-56 sm:min-h-0">
          <img
            src="/panduan/img/pwa-offline/03-jual-tanpa-internet.webp"
            alt="Skrin jualan Warung dalam mod luar talian: pesanan disimpan secara tempatan dan disegerakkan apabila kembali dalam talian"
            width="2560" height="1600" loading="lazy" decoding="async"
            class="absolute left-6 top-6 sm:top-9 sm:left-0 h-[calc(100%+2rem)] w-auto max-w-none rounded-tl-2xl ring-1 ring-white/10 object-cover object-left-top bg-sand text-transparent"
          />
        </div>
      </article>

      <!-- Payment photo, tall -->
      <article class={`${tile} bg-sand min-h-96 lg:row-span-2`}>
        <img src={photos.payment.src} srcset={photos.payment.srcset} sizes="(min-width: 1024px) 400px, 100vw"
          alt={photos.payment.alt} width={photos.payment.width} height={photos.payment.height}
          loading="lazy" decoding="async" class={imgClass} />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/30 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-0 p-7">
          <h3 class="text-2xl font-extrabold tracking-tight text-white">Pelbagai Kaedah Bayaran</h3>
          <p class="mt-2 text-white/85 leading-relaxed">
            Terima bayaran tunai, QR Pay dan kad — semua dalam satu sistem. Fleksibel untuk pelanggan anda.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2" role="list">
            {['Tunai', 'QR Pay', 'Kad'].map((m) => (
              <li class="rounded-full bg-white px-3 py-1 text-sm font-semibold text-ink">{m}</li>
            ))}
          </ul>
        </div>
      </article>

      <!-- POS -->
      <article class={`${tile} bg-white p-7 sm:p-8 ring-1 ring-ink/5`}>
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800" set:html={icons.receipt} />
        <h3 class="mt-6 text-xl font-extrabold tracking-tight text-ink">Sistem POS Mudah</h3>
        <p class="mt-3 text-neutral-600 leading-relaxed">
          Antara muka yang ringkas dan mesra pengguna. Tambah produk, urus pesanan dan terima bayaran dalam beberapa klik sahaja.
        </p>
      </article>

      <!-- Reports -->
      <article class={`${tile} bg-white p-7 sm:p-8 ring-1 ring-ink/5`}>
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-800" set:html={icons.chart} />
        <h3 class="mt-6 text-xl font-extrabold tracking-tight text-ink">Laporan Jualan</h3>
        <p class="mt-3 text-neutral-600 leading-relaxed">
          Pantau jualan harian, mingguan dan bulanan. Ketahui produk terlaris dan waktu puncak perniagaan anda.
        </p>
      </article>

      <!-- Inventory, food photo, tall -->
      <article class={`${tile} bg-sand min-h-96 lg:row-span-2`}>
        <img src={photos.food.src} srcset={photos.food.srcset} sizes="(min-width: 1024px) 400px, 100vw"
          alt={photos.food.alt} width={photos.food.width} height={photos.food.height}
          loading="lazy" decoding="async" class={imgClass} />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/30 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-0 p-7">
          <h3 class="text-2xl font-extrabold tracking-tight text-white">Urus Inventori</h3>
          <p class="mt-2 text-white/85 leading-relaxed">
            Tambah, edit dan susun produk mengikut kategori. Urus varian produk seperti saiz dan rasa dengan mudah.
          </p>
        </div>
      </article>

      <!-- Kitchen photo + real KDS screenshot -->
      <article class={`${tile} bg-sand min-h-96 lg:col-span-2`}>
        <img src={photos.kitchen.src} srcset={photos.kitchen.srcset} sizes="(min-width: 1024px) 800px, 100vw"
          alt={photos.kitchen.alt} width={photos.kitchen.width} height={photos.kitchen.height}
          loading="lazy" decoding="async" class={imgClass} />
        <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/60 to-ink/10" aria-hidden="true"></div>
        <div class="relative grid h-full gap-6 p-7 sm:p-9 sm:grid-cols-2 sm:items-center">
          <div>
            <h3 class="text-2xl font-extrabold tracking-tight text-white">Paparan Dapur</h3>
            <p class="mt-2 text-white/85 leading-relaxed">
              Pesanan dari kaunter terus muncul di skrin dapur. Tukang masak tekan Mula, kemudian Siap — juruwang tahu bila hidangan sedia.
            </p>
          </div>
          <img
            src="/panduan/img/meja-kds/04-paparan-dapur.webp"
            alt="Paparan dapur Warung dengan dua tiket pesanan dan butang Mula bagi setiap hidangan"
            width="2560" height="1600" loading="lazy" decoding="async"
            class="w-full aspect-[16/10] rounded-xl object-cover object-left-top ring-1 ring-white/15 shadow-2xl bg-ink text-transparent"
          />
        </div>
      </article>

      <!-- Install on phone -->
      <article class={`${tile} bg-amber-400 p-7 sm:p-9 lg:col-span-2 flex flex-col sm:flex-row sm:items-center gap-6`}>
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-ink text-amber-400" set:html={icons.phone} />
        <div>
          <h3 class="text-2xl font-extrabold tracking-tight text-ink">Pasang di Telefon</h3>
          <p class="mt-2 text-ink/80 leading-relaxed max-w-xl">
            Tidak perlu muat turun dari App Store. Buka di pelayar web dan pasang terus ke skrin utama telefon anda.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

---
const features = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
    title: 'Sistem POS Mudah',
    description: 'Antara muka yang ringkas dan mesra pengguna. Tambah produk, urus pesanan dan terima bayaran dalam beberapa klik sahaja.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3" /></svg>`,
    title: 'Berfungsi Tanpa Internet',
    description: 'Kedai anda tidak akan terganggu walaupun tiada internet. Warung berfungsi secara offline dan sync semula apabila online.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`,
    title: 'Laporan Jualan',
    description: 'Pantau jualan harian, mingguan dan bulanan. Ketahui produk terlaris dan waktu puncak perniagaan anda.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`,
    title: 'Urus Inventori',
    description: 'Tambah, edit dan susun produk mengikut kategori. Urus varian produk seperti saiz dan rasa dengan mudah.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>`,
    title: 'Pelbagai Kaedah Bayaran',
    description: 'Terima bayaran tunai, QR Pay dan kad — semua dalam satu sistem. Fleksibel untuk pelanggan anda.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    title: 'Pasang di Telefon',
    description: 'Tidak perlu muat turun dari App Store. Buka di pelayar web dan pasang terus ke skrin utama telefon anda.',
  },
];
---

<section id="ciri-ciri" class="py-16 sm:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-neutral-900">
        Semua yang anda perlukan untuk urus kedai
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Warung direka khas untuk peniaga kecil di Malaysia — ringkas, pantas dan berkuasa.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="p-6 rounded-2xl border border-neutral-100 hover:border-amber-200 hover:shadow-lg hover:shadow-amber-50 transition-all">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-amber-50 text-amber-600 mb-4">
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">{feature.title}</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

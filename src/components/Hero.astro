---
import { signupUrl } from '../signup';
import { photos } from '../data/photos';
import PosDemo from './PosDemo.astro';

const hero = photos.hero;
const trust = [
  { label: 'Berfungsi tanpa internet', icon: 'M12 20h.01M8.5 16.43a5 5 0 0 1 7 0M5 12.86a10 10 0 0 1 5.17-2.69M19 12.86a10 10 0 0 0-2-1.52M2 8.82a15 15 0 0 1 4.18-2.64M22 8.82a15 15 0 0 0-11.29-3.76M2 2l20 20' },
  { label: 'Pasang di telefon', icon: 'M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM12 18h.01' },
  { label: 'Percuma untuk bermula', icon: 'M20 6 9 17l-5-5' },
];
const focus = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
---

<section class="relative overflow-hidden bg-cream pt-28 pb-24 sm:pt-32 lg:pt-28 lg:pb-24">
  <!-- Soft warm wash, top-right -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 right-[-20%] size-[42rem] rounded-full bg-amber-200/40 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-8">
    <div class="lg:col-span-6 xl:col-span-5">
      <p class="rise inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3.5 py-1.5 text-sm font-semibold text-ink/75">
        <span class="size-2 rounded-full bg-amber-500"></span>
        POS untuk gerai, kedai makan &amp; café
      </p>

      <h1 class="rise mt-5 text-[2.75rem] leading-[1.02] font-extrabold tracking-[-0.035em] text-ink sm:text-6xl lg:text-[3.5rem] xl:text-[4rem]" style="--d: 80ms">
        Juruwang digital untuk
        <span class="relative inline-block whitespace-nowrap">
          <span class="relative z-10">warung</span>
          <svg aria-hidden="true" viewBox="0 0 200 20" preserveAspectRatio="none" class="absolute inset-x-0 -bottom-1 z-0 h-[0.38em] w-full text-amber-400">
            <path d="M3 14C40 6 120 3 197 9" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" />
          </svg>
        </span>
        anda
      </h1>

      <p class="rise mt-5 max-w-xl text-lg leading-relaxed text-ink/70" style="--d: 160ms">
        Sistem POS moden yang mudah digunakan untuk gerai, kedai makan dan café kecil.
        Berfungsi tanpa internet, boleh dipasang di telefon — percuma untuk bermula.
      </p>

      <div class="rise mt-8 flex flex-col gap-3 sm:flex-row" style="--d: 240ms">
        <a
          href={signupUrl()}
          class={`group inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-amber-500 px-7 text-base font-bold text-ink shadow-[0_1px_0_rgb(255_255_255/0.4)_inset,0_10px_24px_-8px_rgb(217_119_6/0.7)] transition-colors hover:bg-amber-400 ${focus}`}
        >
          Mula Percuma
          <svg aria-hidden="true" class="size-5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a
          href="/panduan/"
          class={`inline-flex min-h-13 items-center justify-center rounded-full border-2 border-ink/85 px-7 text-base font-bold text-ink transition-colors hover:bg-ink hover:text-white ${focus}`}
        >
          Lihat Panduan
        </a>
      </div>

      <ul class="rise mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-ink/75" style="--d: 320ms">
        {trust.map((t) => (
          <li class="flex items-center gap-2">
            <span class="grid size-7 place-items-center rounded-full bg-amber-100 text-amber-800">
              <svg aria-hidden="true" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={t.icon} /></svg>
            </span>
            {t.label}
          </li>
        ))}
      </ul>
    </div>

    <!-- Photo + floating product -->
    <div class="relative lg:col-span-6 xl:col-span-7">
      <div class="rise-img relative ml-auto aspect-[4/5] w-full max-w-xl overflow-hidden rounded-[2rem] bg-sand shadow-[0_2px_4px_rgb(9_9_11/0.04),0_30px_60px_-20px_rgb(120_53_15/0.35)] ring-1 ring-ink/5 sm:aspect-[5/4] lg:aspect-[4/5] xl:aspect-[1/1]">
        <img
          src={hero.src}
          srcset={hero.srcset}
          sizes="(min-width: 1280px) 576px, (min-width: 1024px) 50vw, 100vw"
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="size-full object-cover text-transparent"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/25 via-transparent to-transparent"></div>
      </div>

      <!-- Paid toast -->
      <div
        aria-hidden="true"
        class="float-in absolute top-6 right-3 flex items-center gap-3 rounded-2xl bg-white/95 py-2.5 pr-4 pl-2.5 shadow-[0_12px_32px_-12px_rgb(9_9_11/0.35)] ring-1 ring-ink/5 backdrop-blur sm:right-6 lg:-right-4 lg:top-10"
        style="--d: 700ms"
      >
        <span class="grid size-9 place-items-center rounded-xl bg-emerald-500 text-white">
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
        </span>
        <span class="leading-tight">
          <span class="block text-sm font-bold text-ink">Pesanan #0124 dibayar</span>
          <span class="block text-xs font-medium text-ink/55">Tunai · RM 16.50</span>
        </span>
      </div>

      <!-- Receipt card -->
      <div class="float-in absolute -bottom-12 left-2 sm:left-6 lg:-left-8 lg:bottom-8" style="--d: 520ms">
        <PosDemo />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes float-in {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes img-in {
    from { opacity: 0; transform: scale(1.03); }
    to { opacity: 1; transform: none; }
  }
  .rise { animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both; }
  .float-in { animation: float-in 800ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both; }
  .rise-img { animation: img-in 1000ms cubic-bezier(0.2, 0.7, 0.2, 1) 120ms both; }
</style>

---
// Illustrative receipt card — decorative, so hidden from assistive tech.
const items = [
  { name: 'Nasi Lemak Ayam', qty: 1, price: 8.5 },
  { name: 'Roti Canai', qty: 2, price: 1.5 },
  { name: 'Teh Tarik', qty: 2, price: 2.5 },
];
const total = items.reduce((sum, i) => sum + i.qty * i.price, 0);
const rm = (n: number) => `RM ${n.toFixed(2)}`;
---

<div
  aria-hidden="true"
  class="w-64 select-none rounded-3xl border border-ink/5 bg-white p-4 shadow-[0_1px_2px_rgb(9_9_11/0.06),0_12px_24px_-8px_rgb(9_9_11/0.12),0_32px_64px_-24px_rgb(9_9_11/0.25)] sm:w-72 sm:p-5"
>
  <div class="flex items-center justify-between">
    <div>
      <p class="text-[0.6875rem] font-semibold uppercase tracking-wider text-ink/45">Kaunter 1</p>
      <p class="text-sm font-extrabold tracking-tight text-ink">Pesanan #0124</p>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[0.6875rem] font-semibold text-emerald-700">
      <span class="size-1.5 rounded-full bg-emerald-500"></span>
      Luar talian
    </span>
  </div>

  <ul class="mt-4 space-y-2.5">
    {items.map((i) => (
      <li class="flex items-center gap-3 text-sm">
        <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-amber-100 text-xs font-bold text-amber-900">{i.qty}×</span>
        <span class="flex-1 font-medium text-ink/80">{i.name}</span>
        <span class="font-semibold tabular-nums text-ink">{rm(i.qty * i.price)}</span>
      </li>
    ))}
  </ul>

  <div class="mt-4 flex items-baseline justify-between border-t border-dashed border-ink/15 pt-3">
    <span class="text-sm font-semibold text-ink/60">Jumlah</span>
    <span class="text-xl font-extrabold tracking-tight tabular-nums text-ink">{rm(total)}</span>
  </div>

  <div class="mt-3 grid grid-cols-3 gap-1.5 text-center text-xs font-semibold">
    <span class="rounded-lg bg-ink py-2 text-white">Tunai</span>
    <span class="rounded-lg bg-sand py-2 text-ink/70">QR</span>
    <span class="rounded-lg bg-sand py-2 text-ink/70">Kad</span>
  </div>

  <div class="mt-2 rounded-xl bg-amber-500 py-3 text-center text-sm font-extrabold text-ink">
    Bayar {rm(total)}
  </div>
</div>

---
const navLinks = [
  { href: '#ciri-ciri', label: 'Ciri-ciri' },
  { href: '#harga', label: 'Harga' },
  { href: '#hubungi', label: 'Hubungi' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-neutral-100">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.svg" alt="Warung" class="h-9 w-9 rounded-lg" />
      <span class="text-xl font-bold text-neutral-900">Warung</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-neutral-600 hover:text-amber-600 transition-colors">
          {link.label}
        </a>
      ))}
      <span
        class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-amber-500/70 rounded-lg cursor-default"
      >
        Akan Datang
      </span>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-neutral-600 hover:text-amber-600"
      aria-label="Menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-100 bg-white">
    <div class="px-4 py-4 space-y-3">
      {navLinks.map((link) => (
        <a href={link.href} class="block text-sm font-medium text-neutral-600 hover:text-amber-600">
          {link.label}
        </a>
      ))}
      <span
        class="block text-center px-4 py-2 text-sm font-semibold text-white bg-amber-500/70 rounded-lg cursor-default"
      >
        Akan Datang
      </span>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
